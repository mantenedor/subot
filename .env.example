# Copie para .env (scripts/setup.sh faz isso automaticamente e gera GUACDB_PASSWORD).
# Nada aqui é obrigatório para rodar 100% local: sem nenhuma chave remota preenchida, o subot
# funciona inteiramente com o Ollama (roda dentro do próprio container 'agent').

# ---- Guacamole / Postgres ----
GUACDB_USER=guacamole
GUACDB_DATABASE=guacamole_db
GUACDB_PASSWORD=changeme_run_scripts_setup_sh
GUACAMOLE_ADMIN_USER=guacadmin
GUACAMOLE_ADMIN_PASSWORD=guacadmin

# ---- Caddy (proxy/TLS) ----
# Domínio público real, com DNS já apontando para o IP desta VM — Caddy emite e renova o
# certificado Let's Encrypt sozinho, automaticamente, sem nenhum script de bootstrap. Deixando em
# branco (ou 'localhost'), Caddy usa um certificado da própria CA interna dele — funciona pra
# testar localmente, mas o navegador avisa que não é confiável (esperado nesse caso).
SUBOT_DOMAIN=
SUBOT_LETSENCRYPT_EMAIL=
# Usuário do Basic Auth em /api/ — a senha em si nunca fica em texto claro aqui; scripts/setup.sh
# gera SUBOT_API_BASIC_AUTH_HASH (hash bcrypt) automaticamente.
SUBOT_API_BASIC_AUTH_USER=admin
SUBOT_API_BASIC_AUTH_HASH=

# ---- IA local (padrão) ----
# Ollama roda DENTRO do container 'agent' agora (não é mais outro serviço na rede) — daí 127.0.0.1.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- Outros motores locais/self-hosted OpenAI-compatible (opcional) ----
# Ex.: LM Studio ou vLLM rodando fora deste compose, acessível pela rede do host.
LMSTUDIO_BASE_URL=
VLLM_BASE_URL=

# ---- Provedores remotos (opcional — só ficam disponíveis se a chave for preenchida) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ---- Passphrase da chave SSH do bastião ----
# NÃO preencha isto aqui de verdade — scripts/setup.sh gera a chave já protegida por passphrase
# e mostra ela UMA VEZ no terminal (nunca a salva em arquivo nenhum). Pra subir a stack, exporte
# no seu shell antes do 'docker compose up' (não fica em .env, não fica em disco):
#   export SUBOT_SSH_KEY_PASSPHRASE='a-passphrase-que-o-setup.sh-mostrou'
#   docker compose up -d
# Se preencher aqui por conveniência (reinício automático sem intervenção humana), a passphrase
# volta a ficar no mesmo disco que a chave — reduz bastante a proteção, faça isso conscientemente.
SUBOT_SSH_KEY_PASSPHRASE=

# ---- Segurança ----
SUBOT_CONFIRM_TOKEN_TTL_SECONDS=300
# Ative depois de validar que 'chmod 600' em secrets/ssh/* é respeitado no seu ambiente
# (bind mounts a partir de host Windows via Docker Desktop nem sempre preservam permissões POSIX).
SUBOT_STRICT_KEY_PERMS=false
