# TEMPLATE — este arquivo é rastreado no git (é a "abstração da ferramenta"). O arquivo real,
# config/hosts.yaml, é gerado a partir deste por scripts/setup.sh na primeira execução e NUNCA é
# commitado (está em .gitignore) — o inventário real de hosts é dado de ambiente, não código, e
# deve ser preservado só via scripts/backup.sh, separado do repositório.
#
# Adicione hosts editando config/hosts.yaml diretamente, ou via a skill 'onboard-host' /
# ferramenta MCP inventory_connector.add_host (que sempre exige confirmação).
#
# tags: 'protected' e/ou 'prod' fazem a política tratar até comandos 'safe' como 'sensitive', e
# transferências de arquivo como 'destructive' — ver packages/subot_core/subot_core/policy.py.
#
# Estes são exemplos ilustrativos — serão substituídos pelos seus hosts reais em config/hosts.yaml.
hosts:
  example-web-01:
    address: 10.0.0.11
    port: 22
    user: ops
    protocol: ssh
    groups: [web, staging]
    tags: []
    identity_file: null

  example-db-01:
    address: 10.0.0.21
    port: 22
    user: ops
    protocol: ssh
    groups: [db, prod]
    tags: [protected, prod]
    identity_file: null

  example-desktop-01:
    address: 10.0.0.31
    port: 3389
    user: administrator
    protocol: rdp
    groups: [desktops]
    tags: []
    identity_file: null

  # "Console da IA": SSH direto pro container 'agent', só pela rede docker interna (subot_net) —
  # 'agent' é o nome do serviço no compose, resolvido via DNS interno do Docker; nunca sai pra
  # rede da VM. Um dropbear roda em background dentro do agent, na porta 2222, autenticação só
  # por chave (secrets/ssh/guac_console_ed25519, gerada por scripts/setup.sh — sem passphrase de
  # propósito, o alcance dessa chave já é limitado a "dentro do subot_net"). Use com:
  # remote_desktop_connector.open_desktop_session(host="subot-console", ssh_username="subot",
  # ssh_private_key="<conteúdo de secrets/ssh/guac_console_ed25519>") — cai direto num shell
  # dentro do container 'agent', sem precisar de 'docker exec' nem tocar a rede/sshd da VM.
  subot-console:
    address: agent
    port: 2222
    user: subot
    protocol: ssh
    groups: [subot-self]
    tags: []
    identity_file: null
