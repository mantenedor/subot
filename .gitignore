# ---- Dados de ambiente (instância) — NUNCA vão para o git. O repositório carrega só a
# ferramenta; tudo aqui é "insumo de ambiente" e vive exclusivamente nos backups gerados por
# scripts/backup.sh (ver README, seção "Repositório vs. dados de ambiente"). ----

# chaves SSH, TLS, credenciais do proxy. NOTA: 'secrets/**' sozinho com uma negação de arquivo
# aninhado (ex.: '!secrets/ssh/README.md') NÃO funciona em gitignore — negação não resgata um
# arquivo cujo diretório pai já foi excluído por um padrão recursivo. Por isso a re-inclusão do
# README é feita nível a nível, com globs de um nível só (*), nunca recursivos (**), pra não correr
# o risco de acidentalmente destravar a chave privada junto.
secrets/*
!secrets/ssh
secrets/ssh/*
!secrets/ssh/README.md

# volumes persistidos (bancos, gravações, auditoria, modelos, home do agente)
data/**
!data/**/.gitkeep

# inventário real de hosts (o .example é que fica versionado)
config/hosts.yaml

# identidade real da IA nos hosts geridos (usuário, chave, sudoers promovido) — o .example é que
# fica versionado; hosts/*.json são os complementos por-host, também dado de ambiente
ia/policy/managed-identity.json
config/policy/hosts/*.json

# schema do Guacamole, gerado localmente pelo setup.sh a partir da imagem oficial
containers/guacamole/initdb/*.sql

# estado local do repo_guardian_connector (log de auditoria + tokens de confirmação) — não é
# insumo de ambiente de deploy, é estado de dev-time; ainda assim nunca vai para o git
.subot-guardian/

backups/

.env

# credenciais reais do bot Telegram do gate de escalação de privilégio — o .example é que fica
# versionado; o real é gerado por gate/install-gate.sh no host gerenciado (ou
# preparado aqui antes de transferir), nunca commitado
gate/etc/telegram.env

# python
__pycache__/
*.pyc
*.egg-info/
.venv/
*.egg-info

# node / claude code
node_modules/

# registro local de MCP servers para sessão interativa de dev — usa caminhos absolutos desta
# checkout e carrega .env; é estado de dev-time (como .env), não ferramenta versionável
.mcp.json

# sistema
.DS_Store
Thumbs.db
