# Único ponto de entrada público do subot. Caddy cuida de TLS sozinho: com um domínio público de
# verdade em SUBOT_DOMAIN, emite e renova certificado Let's Encrypt automaticamente (sem certbot,
# sem scripts de bootstrap); sem domínio (acesso por IP), usa automaticamente um certificado da
# CA interna do próprio Caddy — o navegador avisa que não é confiável, é esperado, aceite o risco
# pra testar localmente até ter um domínio real.
#
# {$VAR:default} é resolvido pelo próprio Caddy a partir das variáveis de ambiente do container —
# não precisa de sed/entrypoint customizado como no Apache antes.
{
	# Sem valor padrão, {$VAR} vazio vira uma diretiva 'email' sem argumento nenhum e quebra o
	# parse do Caddyfile inteiro — por isso o default aqui, mesmo sendo só um placeholder até
	# você preencher SUBOT_LETSENCRYPT_EMAIL de verdade em .env.
	email {$SUBOT_LETSENCRYPT_EMAIL:admin@localhost}
}

# Rotas compartilhadas entre o site do domínio (quando configurado) e o catch-all por IP abaixo —
# evita duplicar a config duas vezes.
(subot_routes) {
	# Guacamole — único serviço pensado para acesso público direto. A autenticação de verdade
	# acontece no próprio Guacamole (usuário/senha, recomenda-se habilitar TOTP — ver README).
	# 'handle' blocks são mutuamente exclusivos e o Caddy os ordena por especificidade sozinho
	# (mais específico primeiro), então não importa a ordem em que aparecem aqui — mas por
	# clareza, e pra nunca depender dessa regra implícita, todo path fica em um handle explícito.
	handle /guacamole* {
		reverse_proxy guacamole:8080
	}

	# API — desligada do público por padrão (comente o bloco pra desabilitar de vez). Protegida
	# por Basic Auth (hash gerado em scripts/setup.sh) como segunda camada, além da confirmação
	# em duas etapas que o subot_core já exige pra qualquer ação sensível. Roda dentro do
	# container 'agent' agora (não é mais um container separado).
	handle /api* {
		# 'basic_auth' (com underscore) — renomeada de 'basicauth' na v2.8.0 do Caddy.
		basic_auth {
			{$SUBOT_API_BASIC_AUTH_USER} {$SUBOT_API_BASIC_AUTH_HASH}
		}
		uri strip_prefix /api
		reverse_proxy agent:8081
	}

	handle / {
		redir / /guacamole/ 307
	}
}

# Site com o domínio real (ou 'localhost' se SUBOT_DOMAIN não estiver preenchido) — é o que o
# Caddy usa pra saber qual certificado Let's Encrypt emitir via ACME.
{$SUBOT_DOMAIN:localhost} {
	import subot_routes
}

# Catch-all: TLS via SNI só funciona quando o cliente manda um hostname que bate com um site
# block acima. Conectando direto por IP (sem domínio configurado, ou mesmo com um domínio
# configurado mas acessando pelo IP), a maioria dos clientes não manda SNI nenhum (ou manda o
# próprio IP) — sem este bloco, o handshake TLS falha porque o Caddy não sabe qual site servir.
# Usa certificado da CA interna do Caddy (não dá pra emitir Let's Encrypt pra um IP).
:443 {
	import subot_routes
}
