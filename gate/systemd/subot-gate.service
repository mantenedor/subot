[Unit]
Description=subot — gate de escalação de privilégio via Telegram (host gerenciado)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# O daemon roda como root porque precisa poder executar qualquer comando aprovado, em qualquer
# parte do filesystem. Instância única é garantida por flock mantido pelo PRÓPRIO script (fd 9,
# ver topo de subot-gate-daemon.sh) — não por um wrapper 'flock <lockfile> <comando>' aqui no
# ExecStart. Um wrapper externo faria o systemd rastrear o PID do wrapper como 'principal', e com
# KillMode=process (abaixo) um restart mataria só o wrapper, deixando o daemon de verdade órfão
# ainda segurando o lock (herdado por fork) — a próxima instância nunca mais conseguiria adquiri-lo
# (foi exatamente isso que causou um crash loop em produção ao introduzir KillMode=process com o
# wrapper antigo ainda no lugar).
ExecStart=/opt/subot-gate/bin/subot-gate-daemon.sh
Restart=on-failure
RestartSec=5
# KillMode=process (não o padrão 'control-group', que mataria todo o cgroup incl. processos
# filhos que 'bash -c "$cmd"' venha a criar). execute_approved() roda EM LINHA no processo do
# próprio daemon (sem fork em background) de propósito — evita dois comandos aprovados rodando
# concorrentemente, ao custo de um restart no meio de uma execução matar o comando em andamento
# (fica órfão em 'approved', reconcile_on_startup não cobre esse caso; é um custo aceito
# conscientemente, não um bug — ver subot-gate-daemon.sh::execute_approved).
KillMode=process
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# Sem ProtectSystem=/ProtectHome=: o daemon precisa poder escrever em qualquer parte do
# filesystem para executar um comando já aprovado por um humano (ex.: apt-get upgrade, gestão de
# usuários em /home). Restringir isso faria comandos aprovados falharem de forma opaca DEPOIS da
# decisão humana já ter sido tomada — pior do que não ter esse hardening.

[Install]
WantedBy=multi-user.target
