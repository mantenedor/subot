# Template — copie para /opt/subot-gate/etc/telegram.env (root:root, 0600) no host gerenciado e
# preencha os valores reais. NUNCA commitar o arquivo real (só este .example fica no git).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lista de IDs numéricos do Telegram (não @username — veja https://t.me/userinfobot), separados
# por vírgula, autorizados a clicar Permitir/Negar/Adiar. OBRIGATÓRIO sempre que TELEGRAM_CHAT_ID
# for um grupo com mais de uma pessoa: sem isso, qualquer membro do grupo poderia aprovar
# escalação de privilégio. O daemon recusa iniciar se esta variável estiver vazia.
TELEGRAM_AUTHORIZED_IDS=

# Segundos sem NENHUMA decisão (nem permitir/negar/adiar) até negar automaticamente (fail-closed).
# "Adiar" pausa este timeout só para aquele pedido específico — não precisa aumentar isto por
# causa de "Adiar".
TIMEOUT_SECONDS=300

# Normalmente não precisa mudar — existe para apontar a um servidor de teste em QA.
TELEGRAM_API_BASE=https://api.telegram.org
